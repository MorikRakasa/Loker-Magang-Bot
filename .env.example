# ==========================================================
#  Contoh konfigurasi .env
#  Salin file ini menjadi ".env" lalu isi nilainya.
#  JANGAN commit file .env ke Git!
# ==========================================================

# Webhook Discord untuk channel LOWONGAN KERJA
DISCORD_WEBHOOK_LOKER=https://discord.com/api/webhooks/xxxxxxxxxxxx/yyyyyyyyyyyy

# Webhook Discord untuk channel MAGANG
DISCORD_WEBHOOK_MAGANG=https://discord.com/api/webhooks/xxxxxxxxxxxx/zzzzzzzzzzzz

# ID Role yang akan di-mention (kosongkan bila tidak perlu mention)
# Contoh: 1234567890123456789
ROLE_ID_LOKER=
ROLE_ID_MAGANG=